# --- Jev access (pick one; with neither set, Tripwire uses a local mock) ---
# Option A: Vercel AI Gateway (no TypeSafe waitlist)
AI_GATEWAY_API_KEY=
# Option B: TypeSafe directly (waitlist)
TYPESAFE_API_KEY=

# Override the model id if needed (defaults: typesafe-ai/jev via Gateway, jev-latest direct)
# JEV_MODEL=
# Override the base URL if needed
# JEV_BASE_URL=

# --- Claude fallback reviewer for uncertain decisions (optional) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Database (SQLite by default; use Postgres in production) ---
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/tripwire
DATABASE_URL=sqlite:///./tripwire.db

# --- Policy thresholds ---
# Below this Jev confidence, the decision is escalated to the reviewer / a human
TRIPWIRE_LOW_CONFIDENCE=0.6
# Even if Jev says "allow", a destructive probability at/above this needs a human
TRIPWIRE_DESTRUCTIVE_THRESHOLD=0.8
# Even if Jev says "allow", an off-task probability at/above this needs a human
TRIPWIRE_OFF_TASK_THRESHOLD=0.8
